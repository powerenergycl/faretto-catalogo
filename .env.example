# Copiar a .env.local para desarrollo. Vite solo lee variables que empiecen
# con VITE_ y las inyecta al hacer build (no en runtime del server.js).
#
# Apunta al backend de sitio_power corriendo en paralelo (npm run dev en la
# raiz de sitio_power expone el backend en :4000). Si se deja vacio, cae al
# default de produccion (https://powerenergy.cl) definido en src/lib/api.js.
VITE_SITIO_POWER_API_BASE=http://localhost:4000
